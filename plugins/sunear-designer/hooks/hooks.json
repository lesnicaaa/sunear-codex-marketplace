{
  "description": "Keep the authenticated Sunear execution receiver aligned with Codex Desktop sessions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/sunear-codex-receiver-launch.sh\" session-start",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\scripts\\sunear-codex-receiver-launch.ps1\" session-start",
            "timeout": 10,
            "statusMessage": "Starting Sunear receiver"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/sunear-codex-receiver-launch.sh\" session-end",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\scripts\\sunear-codex-receiver-launch.ps1\" session-end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
