{
  "description": "Install and verify the Sunear background receiver for this computer.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/sunear-codex-receiver-launch.sh\" session-start",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\scripts\\sunear-codex-receiver-launch.ps1\" session-start",
            "timeout": 120,
            "statusMessage": "Starting Sunear receiver"
          }
        ]
      }
    ]
  }
}
